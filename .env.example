# GhostShift AI local configuration
# Copy to .env for Docker Compose. The Java app also reads these variables directly.

# Direct backend binding. Keep 127.0.0.1 unless you add authentication.
GHOSTSHIFT_HOST=127.0.0.1
GHOSTSHIFT_PORT=8080

# Local data. Holds the SQLite database, generated reports, and synthetic demo files.
# Docker Compose overrides this with /data.
GHOSTSHIFT_DATA_DIR=./data

# Optional shared secret. When set, every /api/v1 request except /health must send
# Authorization: Bearer <token> or X-GhostShift-Token: <token>. The browser UI keeps
# a pasted token in memory for the current tab only; it is never written to disk.
GHOSTSHIFT_API_TOKEN=

# Ollama runtime and open-weight model. GhostShift works without it, but AI features
# need a reachable Ollama server with the selected model pulled.
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# Docker Compose host ports. Both bind to 127.0.0.1.
GHOSTSHIFT_API_PORT=8080
GHOSTSHIFT_WEB_PORT=3000

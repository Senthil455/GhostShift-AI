# GhostShift AI local configuration
# Copy to .env for Docker Compose. The Java app reads environment variables directly.

# Backend binding. Keep 127.0.0.1 unless you add authentication.
GHOSTSHIFT_HOST=127.0.0.1
GHOSTSHIFT_PORT=8080

# Local data. Holds the SQLite database and generated reports.
# Docker Compose overrides this with /data.
GHOSTSHIFT_DATA_DIR=./data

# Optional shared secret. When set, every /api/v1 request except /health and
# /ai/status must send: Authorization: Bearer <token>. Frontend build-time:
# VITE_GHOSTSHIFT_API_TOKEN must match.
GHOSTSHIFT_API_TOKEN=

# Ollama runtime and open-weight model.
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# Frontend container port.
GHOSTSHIFT_WEB_PORT=3000

# Frontend build-time API token (only needed when API token is enabled).
VITE_GHOSTSHIFT_API_TOKEN=
